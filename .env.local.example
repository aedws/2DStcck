# Supabase (https://supabase.com/dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# V1 개선안 수집용 Google Apps Script 웹앱(`/exec` 배포 URL)
NEXT_PUBLIC_GOOGLE_FEEDBACK_WEB_APP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# 관리자 화면의 새 창 링크용. 시트 자체 공유 권한은 운영자 전용으로 유지합니다.
NEXT_PUBLIC_GOOGLE_FEEDBACK_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit

# V1 종료 뒤 이동할 V2 공개 URL
NEXT_PUBLIC_V2_PUBLIC_URL=https://vstock-v2.aedws98.workers.dev/

# GitHub Pages 배포 시에만 (로컬은 비워둠). 예: /2dstock
# NEXT_PUBLIC_BASE_PATH=

# 참고: SERVICE_ROLE_KEY와 CRON_SECRET은 프론트엔드에 필요 없음.
#   - Edge Function에는 SERVICE_ROLE_KEY가 자동 주입됨
#   - tick-market은 anon key + 시간 게이트로 보호됨 (시크릿 불필요)
